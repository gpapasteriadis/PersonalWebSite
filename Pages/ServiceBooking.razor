@page "/ServiceBooking"

<PageTitle>@L["ServiceBookingDesign"] · George Papasteriadis</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="page">
    <MudButton Href="/#projects" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
        @L["Back"]
    </MudButton>

    <SectionHeader Title="@L["ServiceBookingDesign"]" />

    <div class="phases">
        @for (var i = 0; i < PortfolioContent.ServiceBookingPhaseImages.Count; i++)
        {
            var phase = i + 1;
            var image = PortfolioContent.ServiceBookingPhaseImages[i];
            <MudCard Outlined="true" Class="phase-card reveal">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h5" HtmlTag="h2" Color="Color.Primary">@L["Phase"] @phase</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Href="@image" Target="_blank" rel="noopener"
                                       Color="Color.Primary" aria-label="@L["AriaOpenInNewTab", $"{L["Phase"]} {phase}"]" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <img class="phase-card__image" src="@image" alt="@($"{L["ServiceBookingDesign"]} – {L["Phase"]} {phase}")"
                         loading="@(phase == 1 ? "eager" : "lazy")" />
                </MudCardContent>
            </MudCard>
        }
    </div>
</MudContainer>
