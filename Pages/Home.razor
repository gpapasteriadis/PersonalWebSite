@page "/"
@inject IJSRuntime JS

<About />
<Experience />
<Projects />
<Skills />
<Contact />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Arriving from another page via /#section: scroll once the sections exist.
        if (firstRender)
        {
            await JS.InvokeVoidAsync("site.scrollToHash");
        }
    }
}
