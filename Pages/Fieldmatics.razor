@page "/Fieldmatics"
@inject IJSRuntime JS

<PageTitle>Fieldmatics · George Papasteriadis</PageTitle>

<section id="fm-intro" class="fm-hero">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudButton Href="/#projects" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            @L["FmBackToProjects"]
        </MudButton>
        <div class="fm-hero__content reveal">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="fm-hero__eyebrow">@L["FmEyebrow"]</MudText>
            <MudText Typo="Typo.h2" HtmlTag="h1" Color="Color.Primary">Fieldmatics</MudText>
            <MudText Typo="Typo.h5" Class="fm-hero__tagline">@L["FmTagline"]</MudText>
            <MudChip T="string" Icon="@Icons.Material.Filled.Construction" Color="Color.Warning" Variant="Variant.Text" Class="ml-0">
                @L["FmStatus"]
            </MudChip>
        </div>
        <nav class="fm-toc reveal" aria-label="@L["FmOnThisPage"]">
            <span class="fm-toc__label">@L["FmOnThisPage"]</span>
            @foreach (var section in FieldmaticsContent.Sections)
            {
                <a class="fm-toc__link" href="@section.Href" data-nav-target="@section.SectionId">@L[section.LabelKey]</a>
            }
        </nav>
    </MudContainer>
</section>

<PortfolioSection Id="fm-business" Title="@L["FmBusinessTitle"]">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmBusinessIntro"]</MudText>
    <div class="fm-audience">
        <span class="fm-audience__label">@L["FmBuiltFor"]</span>
        @foreach (var key in FieldmaticsContent.EnvironmentKeys)
        {
            <span class="tech-tag">@L[key]</span>
        }
    </div>
    <FeatureGrid Items="FieldmaticsContent.Highlights" />
</PortfolioSection>

<PortfolioSection Id="fm-how" Title="@L["FmJourneyTitle"]">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmJourneyIntro"]</MudText>
    <Journey Steps="FieldmaticsContent.Journey" ZoneKey="FieldmaticsContent.ZoneKey" BehindTheScenesKey="FmBehindTheScenes" />
</PortfolioSection>

<PortfolioSection Id="fm-design" Title="@L["FmDesignTitle"]">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmDesignIntro"]</MudText>
    <p class="fm-legend">
        <span class="fm-legend__sample" aria-hidden="true"></span>@L["FmDiagramLegend"]
    </p>
    <div class="fm-diagrams">
        @foreach (var diagram in FieldmaticsContent.Diagrams)
        {
            <MudPaper Outlined="true" Class="fm-diagram-card">
                <MudText Typo="Typo.h5" HtmlTag="h3" Color="Color.Primary">@L[diagram.TitleKey]</MudText>
                <MudText Typo="Typo.body2" Class="fm-diagram-card__text">@L[diagram.TextKey]</MudText>
                <MermaidDiagram Id="@diagram.Id" Title="@L[diagram.TitleKey]" Source="@L[diagram.SourceKey]"
                                ErrorText="@L["FmDiagramError"]" />
            </MudPaper>
        }
    </div>
</PortfolioSection>

<PortfolioSection Id="fm-decisions" Title="@L["FmDecisionsTitle"]">
    <FeatureGrid Items="FieldmaticsContent.Decisions" Class="feature-grid--wide" />
</PortfolioSection>

<PortfolioSection Id="fm-stack" Title="@L["FmStackTitle"]">
    <div class="fm-stack">
        @foreach (var group in FieldmaticsContent.TechStack)
        {
            <MudPaper Outlined="true" Class="fm-stack__group">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Color="Color.Primary" Class="fm-stack__title">@L[group.TitleKey]</MudText>
                <TechTags Items="group.Items" />
            </MudPaper>
        }
    </div>
    <div class="fm-back">
        <MudButton Href="/#projects" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            @L["FmBackToProjects"]
        </MudButton>
    </div>
</PortfolioSection>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Direct links such as /Fieldmatics#fm-design: scroll once the sections exist.
        if (firstRender)
        {
            await JS.InvokeVoidAsync("site.scrollToHash");
        }
    }
}
