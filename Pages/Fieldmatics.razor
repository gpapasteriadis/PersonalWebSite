@page "/Fieldmatics"
@inject IJSRuntime JS

<PageTitle>@L["FmLabel"] · George Papasteriadis</PageTitle>

<section id="fm-intro" class="fm-hero">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudButton Href="@PortfolioContent.ProjectsHref" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            @L["FmBackToProjects"]
        </MudButton>
        <div class="fm-hero__content reveal">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="fm-hero__eyebrow">@L["FmEyebrow"]</MudText>
            <MudText Typo="Typo.h2" HtmlTag="h1" Color="Color.Primary">@L["FmLabel"]</MudText>
            <MudText Typo="Typo.h5" HtmlTag="p" Class="fm-hero__tagline">@L["FmTagline"]</MudText>
            <MudChip T="string" Icon="@Icons.Material.Filled.Construction" Color="Color.Tertiary" Variant="Variant.Filled" Class="ml-0">
                @L["FmStatus"]
            </MudChip>
            <MudText Typo="Typo.body2" Class="fm-hero__now">@L["FmNowText"]</MudText>
        </div>
    </MudContainer>
</section>

@* Page-level (not inside the hero) so it stays pinned while scrolling the whole page. *@
<div class="fm-toc-bar">
    <MudContainer MaxWidth="MaxWidth.Large">
        <nav class="fm-toc" aria-label="@L["FmOnThisPage"]">
            <span class="fm-toc__label">@L["FmOnThisPage"]</span>
            @foreach (var item in FieldmaticsContent.Sections)
            {
                <a class="fm-toc__link" href="@item.Href" data-nav-target="@item.SectionId">@L[item.LabelKey]</a>
            }
        </nav>
    </MudContainer>
</div>

<PortfolioSection Id="fm-problem" Title="@L["FmProblemTitle"]" Class="fm-section">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmProblemText"]</MudText>
    <div class="fm-audience">
        <span class="fm-audience__label">@L["FmBuiltFor"]</span>
        @foreach (var key in FieldmaticsContent.EnvironmentKeys)
        {
            <span class="tech-tag">@L[key]</span>
        }
    </div>
</PortfolioSection>

<PortfolioSection Id="fm-value" Title="@L["FmValueTitle"]" Class="fm-section">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmValueIntro"]</MudText>
    <FeatureGrid Items="FieldmaticsContent.Value" StatusKey="FieldmaticsContent.StatusKey" Class="feature-grid--wide" />
</PortfolioSection>

<PortfolioSection Id="fm-how" Title="@L["FmHowTitle"]" Class="fm-section">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmHowIntro"]</MudText>
    <Journey Steps="FieldmaticsContent.Journey" ZoneKey="FieldmaticsContent.ZoneKey" StatusKey="FieldmaticsContent.StatusKey" />
</PortfolioSection>

<PortfolioSection Id="fm-picture" Title="@L["FmPictureTitle"]" Class="fm-section">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmPictureIntro"]</MudText>
    <p class="fm-legend">
        <span class="fm-legend__sample" aria-hidden="true"></span>@L["FmDiagramLegend"]
    </p>
    <div class="fm-diagrams">
        @foreach (var diagram in FieldmaticsContent.Diagrams)
        {
            <MudPaper Outlined="true" Class="fm-diagram-card">
                <MudText Typo="Typo.h5" HtmlTag="h3" Color="Color.Primary">@L[diagram.TitleKey]</MudText>
                <MudText Typo="Typo.body2" Class="fm-diagram-card__text" id="@($"{diagram.Id}-text")">@L[diagram.TextKey]</MudText>
                <MermaidDiagram Id="@diagram.Id" Title="@L[diagram.TitleKey]" Source="@L[diagram.SourceKey]"
                                ErrorText="@L["FmDiagramError"]" DescriptionId="@($"{diagram.Id}-text")" />
            </MudPaper>
        }
    </div>
</PortfolioSection>

<PortfolioSection Id="fm-trust" Title="@L["FmTrustTitle"]" Class="fm-section">
    <FeatureGrid Items="FieldmaticsContent.Trust" />
</PortfolioSection>

<PortfolioSection Id="fm-stack" Title="@L["FmStackTitle"]" Class="fm-section">
    <MudText Typo="Typo.body1" Class="fm-lead">@L["FmStackText"]</MudText>
    <div class="fm-stack">
        <TechTags Items="PortfolioContent.Fieldmatics.Tech" />
    </div>
    <div class="fm-back">
        <MudButton Href="@PortfolioContent.ProjectsHref" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            @L["FmBackToProjects"]
        </MudButton>
    </div>
</PortfolioSection>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Direct links such as /Fieldmatics#fm-picture: scroll once the sections exist.
        if (firstRender)
        {
            await JS.InvokeVoidAsync("site.scrollToHash");
        }
    }
}
