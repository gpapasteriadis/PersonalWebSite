@* Illustrated, numbered "how it works" journey. Each step shows the zone it happens in. *@
<ol class="journey">
    @for (var i = 0; i < Steps.Count; i++)
    {
        var step = Steps[i];
        <li class="journey-step journey-step--@step.Zone.ToString().ToLowerInvariant()" style="--step-delay: @(i * 70)ms;">
            <div class="journey-step__head">
                <span class="journey-step__icon" aria-hidden="true">
                    <MudIcon Icon="@step.Icon" Size="Size.Medium" />
                    <span class="journey-step__number">@(i + 1)</span>
                </span>
                <span class="journey-step__zone">@L[ZoneKey(step.Zone)]</span>
            </div>
            <MudText Typo="Typo.h6" HtmlTag="h3" Color="Color.Primary" Class="journey-step__title">
                <span class="visually-hidden">@(i + 1). </span>@L[step.TitleKey]
            </MudText>
            <MudText Typo="Typo.body2" Class="journey-step__text">@L[step.TextKey]</MudText>
            <p class="journey-step__tech">
                <strong>@L[BehindTheScenesKey]:</strong> @L[step.TechKey]
            </p>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<JourneyStep> Steps { get; set; } = [];

    /// <summary>Maps a zone to its localized label key.</summary>
    [Parameter, EditorRequired] public Func<JourneyZone, string> ZoneKey { get; set; } = _ => "";

    [Parameter, EditorRequired] public string BehindTheScenesKey { get; set; } = "";
}
