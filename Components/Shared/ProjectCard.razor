@* Card layout shared by every project: label + title + actions, body, tech tags. *@
<MudCard Outlined="true" Class="@($"project-card {Class}")">
    <MudCardHeader Class="project-card__header">
        <CardHeaderContent>
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="project-card__label">@L[Project.LabelKey]</MudText>
            <MudText Typo="Typo.h5" HtmlTag="h3" Color="Color.Primary" Class="project-card__title">@(Title is null ? L.Html(Project.TitleKey) : new MarkupString(Title))</MudText>
        </CardHeaderContent>
        <CardHeaderActions>@Actions</CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="project-card__body">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <MudText Typo="Typo.body1">@L.Html(Project.DescriptionKey)</MudText>
        }
    </MudCardContent>
    @if (ShowTech)
    {
        <MudCardActions Class="project-card__footer">
            <TechTags Items="Project.Tech" />
        </MudCardActions>
    }
</MudCard>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;

    /// <summary>Overrides the title (localized markup). Defaults to the project's title key.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Overrides the body. Defaults to the project's description.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool ShowTech { get; set; } = true;
    [Parameter] public string? Class { get; set; }
}
