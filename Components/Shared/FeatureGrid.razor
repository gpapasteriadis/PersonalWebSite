@* Responsive grid of icon cards (title + text), e.g. product highlights or design decisions. *@
<ul class="feature-grid @Class">
    @foreach (var feature in Items)
    {
        <li class="feature-card">
            <span class="feature-card__icon" aria-hidden="true">
                <MudIcon Icon="@feature.Icon" Size="Size.Medium" />
            </span>
            <MudText Typo="Typo.h6" HtmlTag="h3" Color="Color.Primary" Class="feature-card__title">@L[feature.TitleKey]</MudText>
            <MudText Typo="Typo.body2" Class="feature-card__text">@L.Html(feature.TextKey)</MudText>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Feature> Items { get; set; } = [];
    [Parameter] public string? Class { get; set; }
}
