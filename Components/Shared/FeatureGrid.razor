@* Responsive grid of icon cards (title + text), e.g. value propositions or principles. *@
<ul class="feature-grid @Class">
    @foreach (var feature in Items)
    {
        <li class="feature-card @(feature.IsPlanned ? "feature-card--planned" : null)">
            <div class="feature-card__head">
                <span class="feature-card__icon" aria-hidden="true">
                    <MudIcon Icon="@feature.Icon" Size="Size.Medium" />
                </span>
                @if (feature.IsPlanned && PlannedKey is not null)
                {
                    <span class="feature-card__badge">@L[PlannedKey]</span>
                }
            </div>
            <MudText Typo="Typo.h6" HtmlTag="h3" Color="Color.Primary" Class="feature-card__title">@L[feature.TitleKey]</MudText>
            <MudText Typo="Typo.body2" Class="feature-card__text">@L.Html(feature.TextKey)</MudText>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Feature> Items { get; set; } = [];

    /// <summary>Label of the badge on planned features (resx key).</summary>
    [Parameter] public string? PlannedKey { get; set; }

    [Parameter] public string? Class { get; set; }
}
