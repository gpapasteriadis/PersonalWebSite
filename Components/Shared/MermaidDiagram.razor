@implements IDisposable
@inject IJSRuntime JS
@inject UiState State

@* Renders Mermaid source client-side (site.renderDiagram). Mermaid is loaded from the CDN on first use only,
   and the diagram is re-rendered when the theme changes so its colors follow the palette.
   The canvas must stay empty in Razor: JS owns its content (CSS shows a loading state while it is :empty). *@
<figure class="diagram">
    <div id="@Id" class="diagram__canvas" @ref="_canvas" role="img" aria-label="@Title" aria-describedby="@DescriptionId"></div>
</figure>

@code {
    private ElementReference _canvas;
    private bool _renderedDark;

    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Id of the visible text that describes the diagram (its text alternative).</summary>
    [Parameter] public string? DescriptionId { get; set; }

    /// <summary>Mermaid source (localized).</summary>
    [Parameter, EditorRequired] public string Source { get; set; } = "";

    /// <summary>Shown instead of the diagram if Mermaid fails to load or parse.</summary>
    [Parameter] public string ErrorText { get; set; } = "";

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderDiagramAsync();
        }
    }

    private void OnStateChanged()
    {
        if (State.IsDarkMode != _renderedDark)
        {
            _ = InvokeAsync(RenderSafelyAsync);
        }
    }

    // Theme changes re-render outside the normal lifecycle; never let an interop failure go unobserved.
    private async Task RenderSafelyAsync()
    {
        try
        {
            await RenderDiagramAsync();
        }
        catch (JSException)
        {
            // site.renderDiagram shows its own error text; nothing else to do here.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task RenderDiagramAsync()
    {
        _renderedDark = State.IsDarkMode;
        await JS.InvokeVoidAsync("site.renderDiagram", _canvas, Source, ErrorText);
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
