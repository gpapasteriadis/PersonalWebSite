@inject IConfiguration Config

<PortfolioSection Id="contact" Title="@L["ContactTitle"]" Class="contact">
    <MudPaper Outlined="true" Class="contact-card">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" EndIcon="@Icons.Material.Filled.Email"
                   Href="@($"mailto:{Config["Email"]}")">
            @L["SendMeMail"]
        </MudButton>
        <MudText Typo="Typo.h6" Class="contact-card__email">@Config["Email"]</MudText>

        <MudDivider Class="contact-card__divider" />

        <MudText Typo="Typo.body1" Align="Align.Center">@L["FindMe"]</MudText>
        <div class="socials">
            @foreach (var social in PortfolioContent.SocialLinks)
            {
                <MudIconButton Icon="@social.Icon" Href="@Config[social.LinkKey]" Target="_blank" rel="noopener"
                               Color="Color.Primary" Size="Size.Large" Class="socials__link"
                               title="@social.Name" aria-label="@social.Name" />
            }
        </div>
    </MudPaper>
</PortfolioSection>

<footer class="site-footer">
    <MudText Typo="Typo.caption" Align="Align.Center">@L.Html("BuildBy")</MudText>
</footer>
