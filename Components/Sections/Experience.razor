@inject IConfiguration Config

<PortfolioSection Id="jobs" Title="@L["ExperienceTitle"]">
    <Subtitle>
        @* The whole pill is the link: a large, labelled target that opens the PDF in a new tab. *@
        <a class="cv-link" href="@PortfolioContent.CvPath" target="_blank" rel="noopener">
            <MudIcon Icon="@Icons.Material.Filled.Description" aria-hidden="true" />
            <span>@L["ViewCV"]</span>
            <span class="visually-hidden">@L["AriaOpensNewTab"]</span>
            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="cv-link__external" aria-hidden="true" />
        </a>
    </Subtitle>
    <ChildContent>
        @* Tablet/desktop: timeline *@
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudTimeline TimelinePosition="TimelinePosition.Start" Class="experience-timeline">
                @foreach (var job in PortfolioContent.Jobs)
                {
                    <MudTimelineItem Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                        <MudPaper Outlined="true" Class="job-card">@JobDetails(job)</MudPaper>
                    </MudTimelineItem>
                }
            </MudTimeline>
        </MudHidden>

        @* Phone: one tab per company *@
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudPaper Outlined="true" Class="job-card job-card--tabs">
                <MudTabs Rounded="true" Centered="true" MinimumTabWidth="70px" TabPanelsClass="pt-4" Class="experience-tabs">
                    @foreach (var job in PortfolioContent.Jobs)
                    {
                        <MudTabPanel Text="@Text(job, job.ShortName)">@JobDetails(job)</MudTabPanel>
                    }
                </MudTabs>
            </MudPaper>
        </MudHidden>
    </ChildContent>
</PortfolioSection>

@code {
    private string Text(Job job, string value) => job.IsLocalized ? L[value] : value;

    private RenderFragment JobDetails(Job job) =>
        @<div class="job">
            <div class="job__heading">
                <MudText Typo="Typo.h6" HtmlTag="h3" Color="Color.Primary" Class="job__role">
                    @L.Html(job.RoleKey)
                    <MudLink Href="@Config[job.LinkKey]" Target="_blank" rel="noopener" Color="Color.Secondary"
                             Typo="Typo.h6" Class="job__company">@@@Text(job, job.Company)</MudLink>
                </MudText>
                <span class="job__date">@L[job.DateKey]</span>
            </div>
            <MudText Typo="Typo.body1" HtmlTag="div" Class="job__description">@L.Html(job.DescriptionKey)</MudText>
        </div>;
}
