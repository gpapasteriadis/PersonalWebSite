@inject IConfiguration Config

<PortfolioSection Id="projects" Title="@L["ProjectsTitle"]">
    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <ProjectCard Project="PortfolioContent.PersonalWebsite">
                <Actions>
                    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Href="@Config["Projects:PersonalWebsite_Git"]"
                                   Target="_blank" rel="noopener" Color="Color.Primary" aria-label="GitHub" />
                </Actions>
            </ProjectCard>
        </MudItem>

        <MudItem xs="12" md="6">
            @* The FoodWaste card flips to a media gallery; @key re-creates the card so the flip animation replays. *@
            <div @key="_showGallery" class="flip-in">
                @if (_showGallery)
                {
                    <ProjectCard Project="PortfolioContent.MobileApp" Title="@L["MobileAppTitle2"]" ShowTech="false">
                        <Actions>
                            <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" OnClick="ToggleGallery" Color="Color.Primary"
                                           title="@L["Back"]" aria-label="@L["Back"]" />
                        </Actions>
                        <ChildContent>
                            <div class="gallery">
                                <video class="gallery__item" controls preload="metadata" width="250" height="430" aria-label="@L["MobileAppVideo"]">
                                    <source src="/Video/FoodWasteApp.mp4" type="video/mp4" />
                                </video>
                                <img class="gallery__item" src="/Icons/1.png" alt="@L["MobileAppScreenshot", 1]" loading="lazy" width="250" height="280" />
                                <img class="gallery__item" src="/Icons/2.png" alt="@L["MobileAppScreenshot", 2]" loading="lazy" width="250" height="280" />
                            </div>
                        </ChildContent>
                    </ProjectCard>
                }
                else
                {
                    <ProjectCard Project="PortfolioContent.MobileApp">
                        <Actions>
                            <MudIconButton Icon="@Icons.Material.Rounded.Image" OnClick="ToggleGallery" Color="Color.Primary"
                                           Class="attention" title="@L["MobileAppShowSample"]" aria-label="@L["MobileAppShowSample"]" />
                        </Actions>
                    </ProjectCard>
                }
            </div>
        </MudItem>

        <MudItem xs="12">
            <ProjectCard Project="PortfolioContent.ServiceBooking">
                <Actions>
                    <MudIconButton Icon="@Icons.Material.Filled.DesignServices" Href="@Config["Projects:LocalServiceBooking_DesignPage"]"
                                   Color="Color.Primary" title="@L["SystemDesign"]" aria-label="@L["SystemDesign"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Disabled="true" Color="Color.Primary" aria-label="@L["ServiceBooking"]" />
                </Actions>
                <ChildContent>
                    <MudChip T="string" Icon="@Icons.Material.Filled.Construction" Color="Color.Warning" Variant="Variant.Text"
                             Class="mb-3 ml-0">@L.Html("UnderConstruction")</MudChip>
                    <MudText Typo="Typo.body1">@L.Html("ServiceBookingDesc")</MudText>
                </ChildContent>
            </ProjectCard>
        </MudItem>
    </MudGrid>
</PortfolioSection>

@code {
    private bool _showGallery;

    private void ToggleGallery() => _showGallery = !_showGallery;
}
