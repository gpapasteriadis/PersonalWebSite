<section id="about" class="hero">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="hero__grid">
            <div class="hero__avatar reveal">
                <img src="@PortfolioContent.AvatarPath" alt="George Papasteriadis" width="250" height="280" />
            </div>
            <div class="hero__text reveal">
                <MudText Typo="Typo.h5" Color="Color.Secondary" GutterBottom="true">@L["Salutation"]</MudText>
                <MudText Typo="Typo.h2" HtmlTag="h1" Color="Color.Primary" GutterBottom="true" Class="hero__name">
                    @L.Html("MyName")
                </MudText>
                <MudText Typo="Typo.body1" Class="hero__about">@L.Html("About")</MudText>
            </div>
        </div>
    </MudContainer>
</section>
