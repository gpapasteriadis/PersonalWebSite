@inject ISnackbar Snackbar

<PortfolioSection Id="skills" Title="@L["SkillsTitle"]">
    <ul class="skills">
        @for (var i = 0; i < PortfolioContent.Skills.Count; i++)
        {
            var skill = PortfolioContent.Skills[i];
            <li class="skills__item" style="--skill-animation: @skill.Animation; --skill-delay: @(i * 90)ms;">
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                         Class="skill-chip" OnClick="() => ShowDetails(skill)">
                    <span class="skill-chip__icon" aria-hidden="true">@((MarkupString)skill.IconSvg)</span>
                    <span class="skill-chip__name">@skill.Name</span>
                </MudChip>
            </li>
        }
    </ul>
</PortfolioSection>

@code {
    private void ShowDetails(Skill skill)
    {
        Snackbar.Clear();
        Snackbar.Add(
            message: @<div class="skill-details">
                <strong class="skill-details__name">@skill.Name</strong>
                <MudDivider Class="my-1" />
                <span>@L[skill.DescriptionKey]</span>
                <span class="skill-details__acquired"><u>@L["SkillAcquired"]</u> <b>@L[skill.AcquiredKey]</b></span>
            </div>,
            configure: options =>
            {
                options.Icon = skill.IconSvg;
                options.IconSize = Size.Large;
            },
            key: "Skill");
    }
}
