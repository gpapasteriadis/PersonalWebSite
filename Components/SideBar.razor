@implements IDisposable
@inject UiState State

<MudDrawer Open="State.IsDrawerOpen" OpenChanged="State.SetDrawerOpen" Variant="DrawerVariant.Temporary"
           Anchor="Anchor.Start" Width="min(75vw, 280px)" Elevation="2" Class="site-drawer">
    <MudDrawerHeader Class="site-drawer__header">
        <button type="button" class="site-logo" @onclick="State.GoHomeAsync" aria-label="@L["AriaHome"]">
            <img src="@PortfolioContent.LogoPath" alt="" width="40" height="40" />
        </button>
    </MudDrawerHeader>
    <nav class="site-drawer__nav" aria-label="@L["AriaMainNav"]">
        @foreach (var item in PortfolioContent.Navigation)
        {
            <a class="site-drawer__link" href="@item.Href" data-nav-target="@item.SectionId"
               @onclick="() => State.SetDrawerOpen(false)">@L[item.LabelKey]</a>
        }
    </nav>
</MudDrawer>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;
}
