@inject UiState State

@* Shows the language you can switch to (EN while viewing Greek, ΕΛ while viewing English). *@
<MudButton Variant="Variant.Text" Color="Color.Inherit" Class="culture-toggle" OnClick="State.ToggleCultureAsync"
           aria-label="@L["AriaSwitchLanguage"]">
    @L[UiState.IsGreek ? "EnglishCulture" : "GreekCulture"]
</MudButton>
